<Window x:Class="ImageConverterPro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:ImageConverterPro.Views"
        mc:Ignorable="d"
        Title="Image Converter Pro" 
        Icon="/Resources/AppIcon.ico"
        Height="820" Width="1280"
        MinHeight="640" MinWidth="980"
        WindowStyle="None" 
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI"
        FontSize="13">
    
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5" CornerRadius="0" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Border Background="{DynamicResource WindowBackground}" 
            BorderBrush="{DynamicResource BorderBrush}" 
            BorderThickness="1" 
            CornerRadius="12"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Grid Grid.Row="0" Background="{DynamicResource SurfaceBackground}" Height="48" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Orientation="Horizontal" Grid.Column="0" Margin="16,0">
                    <Border Width="30" Height="30" Background="{DynamicResource AccentColor}" CornerRadius="8" VerticalAlignment="Center" ClipToBounds="True">
                        <Image Source="/Resources/AppIcon.png" Stretch="Uniform" Margin="2"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="9,0,0,0">
                        <TextBlock Text="Image Converter Pro" Foreground="{DynamicResource PrimaryText}" FontWeight="SemiBold" FontSize="15"/>
                        <TextBlock Text="IMAGE WORKSPACE" Foreground="{DynamicResource SecondaryText}" FontSize="8" FontWeight="SemiBold"/>
                    </StackPanel>
                    <Menu Background="Transparent" Margin="22,0,0,0" VerticalAlignment="Center">
                        <MenuItem Header="_File">
                            <MenuItem Header="_Open" Command="{Binding OpenFilesCommand}" InputGestureText="Ctrl+O"/>
                            <MenuItem Header="Recent files" ItemsSource="{Binding RecentFiles}">
                                <MenuItem.ItemContainerStyle>
                                    <Style TargetType="MenuItem">
                                        <Setter Property="Header" Value="{Binding DisplayName}"/>
                                        <Setter Property="ToolTip" Value="{Binding FilePath}"/>
                                        <Setter Property="Command" Value="{Binding DataContext.OpenRecentFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        <Setter Property="CommandParameter" Value="{Binding}"/>
                                    </Style>
                                </MenuItem.ItemContainerStyle>
                            </MenuItem>
                            <MenuItem Header="Clear recent files" Command="{Binding ClearRecentFilesCommand}"/>
                            <Separator/>
                            <MenuItem Header="E_xit" Command="{Binding ExitApplicationCommand}"/>
                        </MenuItem>
                        <MenuItem Header="_Help">
                            <MenuItem Header="About Image Converter Pro" Command="{Binding ShowAboutCommand}"/>
                        </MenuItem>
                    </Menu>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Grid.Column="2" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Click="Minimize_Click" Width="46" Height="48" Style="{DynamicResource WindowButtonStyle}" Content="&#xE921;" FontFamily="Segoe MDL2 Assets"/>
                    <Button Click="Maximize_Click" Width="46" Height="48" Style="{DynamicResource WindowButtonStyle}" Content="&#xE922;" FontFamily="Segoe MDL2 Assets"/>
                    <Button Click="Close_Click" Width="46" Height="48" Style="{DynamicResource WindowCloseButtonStyle}" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets"/>
                </StackPanel>
            </Grid>

            <!-- Navigation Bar -->
            <Border Grid.Row="1" Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" Margin="16,0,0,0" Height="42">
                    <RadioButton Content="Convert" GroupName="NavTabs" IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IndexToBoolConverter}, ConverterParameter=0}" Style="{DynamicResource NavTabStyle}"/>
                    <RadioButton Content="Edit" GroupName="NavTabs" IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IndexToBoolConverter}, ConverterParameter=1}" Style="{DynamicResource NavTabStyle}"/>
                    <RadioButton Content="History" GroupName="NavTabs" IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IndexToBoolConverter}, ConverterParameter=2}" Style="{DynamicResource NavTabStyle}"/>
                    <RadioButton Content="Settings" GroupName="NavTabs" IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IndexToBoolConverter}, ConverterParameter=3}" Style="{DynamicResource NavTabStyle}"/>
                </StackPanel>
            </Border>

            <!-- Content -->
            <ContentControl Grid.Row="2" Margin="0">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTabIndex}" Value="0">
                                <Setter Property="Content">
                                    <Setter.Value>
                                        <views:ConvertView DataContext="{Binding ConvertViewModel}"/>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedTabIndex}" Value="1">
                                <Setter Property="Content">
                                    <Setter.Value>
                                        <views:EditView DataContext="{Binding EditViewModel}"/>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedTabIndex}" Value="2">
                                <Setter Property="Content">
                                    <Setter.Value>
                                        <views:HistoryView DataContext="{Binding HistoryViewModel}"/>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedTabIndex}" Value="3">
                                <Setter Property="Content">
                                    <Setter.Value>
                                        <views:SettingsView DataContext="{Binding SettingsViewModel}"/>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>

            <!-- Status Bar -->
            <Border Grid.Row="3" Background="{DynamicResource StatusBarBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Height="32">
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" FontSize="11"/>
                    
                    <ProgressBar Grid.Column="2" Width="100" Height="4" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" VerticalAlignment="Center" Margin="10,0"/>
                </Grid>
            </Border>

            <!-- Custom Resize Grip -->
            <Path Grid.Row="3" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2" 
                  Data="M 8 0 L 8 2 L 6 2 L 6 4 L 4 4 L 4 6 L 2 6 L 2 8 L 0 8 L 0 10 L 10 10 L 10 0 Z" 
                  Fill="{DynamicResource SecondaryText}" Opacity="0.5" Width="10" Height="10" IsHitTestVisible="False"/>
        </Grid>
    </Border>
</Window>

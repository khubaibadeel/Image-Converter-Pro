<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Colors -->
    <Color x:Key="WindowBackgroundColor">#F3F3F3</Color>
    <Color x:Key="SurfaceBackgroundColor">#FFFFFF</Color>
    <Color x:Key="PrimaryTextColor">#1A1A1A</Color>
    <Color x:Key="SecondaryTextColor">#666666</Color>
    <Color x:Key="AccentColorValue">#0078D4</Color>
    <Color x:Key="AccentHoverColor">#106EBE</Color>
    <Color x:Key="BorderColor">#E0E0E0</Color>
    <Color x:Key="DragDropBackgroundColor">#F8F9FA</Color>
    <Color x:Key="DragDropBorderColor">#C8C8C8</Color>
    <Color x:Key="StatusBarBackgroundColor">#F0F0F0</Color>
    <Color x:Key="SuccessColorValue">#107C10</Color>
    <Color x:Key="ErrorColorValue">#D13438</Color>
    <Color x:Key="WarningColorValue">#FF8C00</Color>
    <Color x:Key="TabActiveBackgroundColor">#FFFFFF</Color>
    <Color x:Key="TabInactiveBackgroundColor">#E8E8E8</Color>
    <Color x:Key="SliderTrackColor">#D0D0D0</Color>
    <Color x:Key="SliderThumbColor">#0078D4</Color>
    <Color x:Key="ProgressBarBackgroundColor">#E0E0E0</Color>
    <Color x:Key="ProgressBarForegroundColor">#0078D4</Color>
    <Color x:Key="CardBackgroundColor">#FFFFFF</Color>
    <Color x:Key="CardBorderColor">#E5E5E5</Color>
    <Color x:Key="ShadowColorValue">#20000000</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="WindowBackground" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBackground" Color="{StaticResource SurfaceBackgroundColor}" />
    <SolidColorBrush x:Key="PrimaryText" Color="{StaticResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="SecondaryText" Color="{StaticResource SecondaryTextColor}" />
    <SolidColorBrush x:Key="AccentColor" Color="{StaticResource AccentColorValue}" />
    <SolidColorBrush x:Key="AccentHover" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="DragDropBackground" Color="{StaticResource DragDropBackgroundColor}" />
    <SolidColorBrush x:Key="DragDropBorder" Color="{StaticResource DragDropBorderColor}" />
    <SolidColorBrush x:Key="StatusBarBackground" Color="{StaticResource StatusBarBackgroundColor}" />
    <SolidColorBrush x:Key="SuccessColor" Color="{StaticResource SuccessColorValue}" />
    <SolidColorBrush x:Key="ErrorColor" Color="{StaticResource ErrorColorValue}" />
    <SolidColorBrush x:Key="WarningColor" Color="{StaticResource WarningColorValue}" />
    <SolidColorBrush x:Key="TabActiveBackground" Color="{StaticResource TabActiveBackgroundColor}" />
    <SolidColorBrush x:Key="TabInactiveBackground" Color="{StaticResource TabInactiveBackgroundColor}" />
    <SolidColorBrush x:Key="SliderTrack" Color="{StaticResource SliderTrackColor}" />
    <SolidColorBrush x:Key="SliderThumb" Color="{StaticResource SliderThumbColor}" />
    <SolidColorBrush x:Key="ProgressBarBackground" Color="{StaticResource ProgressBarBackgroundColor}" />
    <SolidColorBrush x:Key="ProgressBarForeground" Color="{StaticResource ProgressBarForegroundColor}" />
    <SolidColorBrush x:Key="CardBackground" Color="{StaticResource CardBackgroundColor}" />
    <SolidColorBrush x:Key="CardBorder" Color="{StaticResource CardBorderColor}" />
    <SolidColorBrush x:Key="ShadowColor" Color="{StaticResource ShadowColorValue}" />
</ResourceDictionary>

<UserControl x:Class="ImageConverterPro.Views.ConvertView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="760" d:DesignWidth="1280"
             Background="Transparent">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Drag & Drop / Quick Action Banner -->
        <Border Grid.Row="0" Style="{DynamicResource CardStyle}" Padding="14,10" Margin="0,0,0,12"
                Background="{DynamicResource DragDropBackground}" BorderBrush="{DynamicResource DragDropBorder}"
                AllowDrop="True" Drop="DropZone_Drop" DragEnter="DropZone_DragEnter" DragLeave="DropZone_DragLeave">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <Border Width="40" Height="40" Background="{DynamicResource AccentColor}" CornerRadius="10" VerticalAlignment="Center">
                    <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                
                <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                    <TextBlock Text="Add images to your conversion queue" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource PrimaryText}"/>
                    <TextBlock Text="Drag and drop files or folders here, or use the browse buttons. Originals remain untouched." Foreground="{DynamicResource SecondaryText}" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>
                
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Add files" Command="{Binding AddFilesCommand}" Style="{DynamicResource PrimaryButtonStyle}" MinWidth="95" Margin="0,0,8,0"/>
                    <Button Content="Add folder" Command="{Binding AddFolderCommand}" Style="{DynamicResource SecondaryButtonStyle}" MinWidth="95"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Workspace -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="250" MaxWidth="360"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*" MinWidth="360"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="310" MinWidth="270" MaxWidth="380"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: QUEUE & IMAGE INFORMATION PANEL -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Queue List Card -->
                <Border Grid.Row="0" Style="{DynamicResource PanelStyle}" Padding="0" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Queue Header -->
                        <Border Padding="12,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Background="{DynamicResource SurfaceBackground}">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentColor}" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Conversion Queue" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                    <Border Background="{DynamicResource AccentColor}" CornerRadius="10" Margin="8,0,0,0" Padding="6,1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding QueueCount}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                                <Button Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" Command="{Binding ClearFilesCommand}" Style="{DynamicResource IconButtonStyle}" ToolTip="Clear queue" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource ErrorColor}"/>
                            </Grid>
                        </Border>

                        <!-- Queue Items List -->
                        <Grid Grid.Row="1">
                            <ListView ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}" BorderThickness="0" Background="Transparent" Margin="4">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Padding" Value="4"/>
                                        <Setter Property="Margin" Value="0,2"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListViewItem">
                                                    <Border x:Name="itemBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource TabInactiveBackground}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource CardBackground}"/>
                                                            <Setter TargetName="itemBorder" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                                                            <Setter TargetName="itemBorder" Property="BorderThickness" Value="1.5"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid MinHeight="48">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="44"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="24"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <Border Width="40" Height="40" Background="{DynamicResource TransparencyBrush}" CornerRadius="6" ClipToBounds="True" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                            </Border>
                                            
                                            <StackPanel Grid.Column="1" Margin="8,0,4,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding FilePath}"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock Text="{Binding Extension}" Foreground="{DynamicResource AccentColor}" FontSize="10" FontWeight="Bold" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding FileSize, Converter={StaticResource FileSizeConverter}}" Foreground="{DynamicResource SecondaryText}" FontSize="10"/>
                                                </StackPanel>
                                            </StackPanel>
                                            
                                            <Button Grid.Column="2" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" Command="{Binding DataContext.RemoveFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{DynamicResource IconButtonStyle}" Foreground="{DynamicResource SecondaryText}" ToolTip="Remove item" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            
                            <!-- Empty State -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasFiles, Converter={StaticResource InverseBoolToVisibilityConverter}}" Margin="16">
                                <Border Width="48" Height="48" CornerRadius="24" Background="{DynamicResource TabInactiveBackground}" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="{DynamicResource SecondaryText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Queue is empty" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center" Margin="0,10,0,2"/>
                                <TextBlock Text="Add images or folders to begin." Foreground="{DynamicResource SecondaryText}" FontSize="11" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Image Information Panel (TASK 5) -->
                <Border Grid.Row="1" Style="{DynamicResource PanelStyle}" Padding="12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentColor}" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Image Information" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <Grid Visibility="{Binding SelectedFile, Converter={StaticResource NullToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Filename" Foreground="{DynamicResource SecondaryText}" FontSize="11" Margin="0,2"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedImageInformation.FileName, TargetNullValue=—}" FontWeight="SemiBold" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="File size" Foreground="{DynamicResource SecondaryText}" FontSize="11" Margin="0,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedImageInformation.FileSizeDisplay, TargetNullValue=—}" FontSize="11" Margin="0,2"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Width" Foreground="{DynamicResource SecondaryText}" FontSize="11" Margin="0,2"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedImageInformation.Width, StringFormat={}{0} px, TargetNullValue=—}" FontSize="11" Margin="0,2"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Height" Foreground="{DynamicResource SecondaryText}" FontSize="11" Margin="0,2"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedImageInformation.Height, StringFormat={}{0} px, TargetNullValue=—}" FontSize="11" Margin="0,2"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Format" Foreground="{DynamicResource SecondaryText}" FontSize="11" Margin="0,2"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedImageInformation.Format, TargetNullValue=—}" FontSize="11" Margin="0,2"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Color mode" Foreground="{DynamicResource SecondaryText}" FontSize="11" Margin="0,2"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedImageInformation.ColorModeDisplay, TargetNullValue=—}" FontSize="11" Margin="0,2"/>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Transparency" Foreground="{DynamicResource SecondaryText}" FontSize="11" Margin="0,2"/>
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SelectedImageInformation.TransparencyDisplay, TargetNullValue=—}" FontSize="11" Margin="0,2"/>

                            <TextBlock Grid.Row="7" Grid.Column="0" Text="Est. output" Foreground="{DynamicResource SecondaryText}" FontSize="11" Margin="0,2"/>
                            <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding QualityComparison.EstimatedSizeDisplay, TargetNullValue=—}" FontWeight="SemiBold" Foreground="{DynamicResource AccentColor}" FontSize="11" Margin="0,2"/>
                        </Grid>

                        <TextBlock Text="Select an image from the queue to view details." Foreground="{DynamicResource SecondaryText}" FontSize="11" Visibility="{Binding SelectedFile, Converter={StaticResource NullToInverseVisibilityConverter}}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- CENTER: PREVIEW WORKSPACE -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Workspace Toolbar -->
                <Grid Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE799;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentColor}" FontSize="15" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Preview Workspace" FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock Text="Side-by-side comparison" Foreground="{DynamicResource SecondaryText}" FontSize="11" Margin="8,2,0,0"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="&#xE8A3;" FontFamily="Segoe MDL2 Assets" Command="{Binding ZoomOutCommand}" Style="{DynamicResource IconButtonStyle}" ToolTip="Zoom out" Width="28" Height="28"/>
                        <Button Content="{Binding PreviewZoom, StringFormat={}{0:0.00}x}" Command="{Binding FitPreviewCommand}" Style="{DynamicResource SecondaryButtonStyle}" Padding="8,2" Margin="4,0" ToolTip="Reset / Fit zoom" FontSize="11"/>
                        <Button Content="&#xE8A4;" FontFamily="Segoe MDL2 Assets" Command="{Binding ZoomInCommand}" Style="{DynamicResource IconButtonStyle}" ToolTip="Zoom in" Width="28" Height="28"/>
                    </StackPanel>
                </Grid>

                <!-- Previews Grid -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Original Preview Card -->
                    <Border Grid.Column="0" Style="{DynamicResource CardStyle}" ClipToBounds="True">
                        <Grid>
                            <Border Height="32" VerticalAlignment="Top" Background="{DynamicResource SurfaceBackground}" Opacity="0.95" Panel.ZIndex="2" Padding="10,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentColor}"/>
                                        <TextBlock Text="Original" Margin="6,0,0,0" FontWeight="SemiBold" FontSize="12"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding SelectedImageInformation.Resolution}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryText}" FontSize="10"/>
                                </Grid>
                            </Border>

                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Margin="0,32,0,0" Background="{DynamicResource TransparencyBrush}">
                                <Viewbox Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Image Source="{Binding OriginalPreview}" Stretch="None" RenderOptions.BitmapScalingMode="HighQuality">
                                        <Image.LayoutTransform>
                                            <ScaleTransform ScaleX="{Binding PreviewZoom}" ScaleY="{Binding PreviewZoom}"/>
                                        </Image.LayoutTransform>
                                    </Image>
                                </Viewbox>
                            </ScrollViewer>

                            <!-- Empty Original Placeholder -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding OriginalPreview, Converter={StaticResource NullToInverseVisibilityConverter}}">
                                <TextBlock Text="&#xE91B;" FontFamily="Segoe MDL2 Assets" FontSize="32" Foreground="{DynamicResource SecondaryText}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Select image to preview original" Foreground="{DynamicResource SecondaryText}" FontSize="12" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Converted Preview Card -->
                    <Border Grid.Column="2" Style="{DynamicResource CardStyle}" ClipToBounds="True">
                        <Grid>
                            <Border Height="34" VerticalAlignment="Top" Background="{DynamicResource SurfaceBackground}" Opacity="0.95" Panel.ZIndex="2" Padding="10,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8" Fill="{DynamicResource SuccessColor}"/>
                                        <TextBlock Text="Converted Preview" Margin="6,0,0,0" FontWeight="SemiBold" FontSize="12"/>
                                        <Border Background="{DynamicResource AccentColor}" CornerRadius="3" Padding="4,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TargetFormat}" Foreground="White" FontSize="9" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>
                                    
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Command="{Binding OpenConvertedFileCommand}" Style="{DynamicResource IconButtonStyle}" ToolTip="Open converted image in default application" Padding="4" Margin="0,0,4,0">
                                            <TextBlock Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource PrimaryText}"/>
                                        </Button>
                                        <Button Command="{Binding SaveAsConvertedFileCommand}" Style="{DynamicResource SecondaryButtonStyle}" ToolTip="Save converted image to custom location" Padding="8,2" FontSize="11">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBlock Text="Save As" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Margin="0,32,0,0" Background="{DynamicResource TransparencyBrush}">
                                <Viewbox Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Image Source="{Binding ConvertedPreview}" Stretch="None" RenderOptions.BitmapScalingMode="HighQuality">
                                        <Image.LayoutTransform>
                                            <ScaleTransform ScaleX="{Binding PreviewZoom}" ScaleY="{Binding PreviewZoom}"/>
                                        </Image.LayoutTransform>
                                    </Image>
                                </Viewbox>
                            </ScrollViewer>

                            <!-- Empty Converted Placeholder -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding ConvertedPreview, Converter={StaticResource NullToInverseVisibilityConverter}}">
                                <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="32" Foreground="{DynamicResource SecondaryText}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Live preview updates instantly" Foreground="{DynamicResource SecondaryText}" FontSize="12" Margin="0,8,0,0"/>
                            </StackPanel>

                            <!-- Live Loading Indicator Overlay -->
                            <Border Background="#A5000000" Visibility="{Binding IsLoadingPreview, Converter={StaticResource BoolToVisibilityConverter}}" Panel.ZIndex="3">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ProgressBar Width="100" Height="4" IsIndeterminate="True"/>
                                    <TextBlock Text="Rendering preview..." Foreground="White" FontSize="11" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- RIGHT: SETTINGS PANEL -->
            <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentColor}" FontSize="15" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Conversion Settings" FontWeight="SemiBold" FontSize="14"/>
                    </StackPanel>

                    <!-- Format & Quality Card -->
                    <Border Style="{DynamicResource PanelStyle}" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Format &amp; Quality" FontWeight="SemiBold" FontSize="12"/>
                            <TextBlock Text="Select target file format and quality compression." Foreground="{DynamicResource SecondaryText}" FontSize="11" Margin="0,2,0,10"/>
                            
                            <TextBlock Text="Target Format" Foreground="{DynamicResource SecondaryText}" FontSize="11" Margin="0,0,0,3"/>
                            <ComboBox ItemsSource="{Binding AvailableFormats}" SelectedItem="{Binding TargetFormat}" Style="{DynamicResource ComboBoxStyle}" Margin="0,0,0,12"/>
                            
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Quality / Compression" Foreground="{DynamicResource SecondaryText}" FontSize="11" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding Quality}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AccentColor}"/>
                                    <TextBlock Text="%" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AccentColor}"/>
                                </StackPanel>
                            </Grid>
                            <Slider Minimum="1" Maximum="100" Value="{Binding Quality, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,12"/>

                            <TextBlock Text="Background Color (for transparent sources)" Foreground="{DynamicResource SecondaryText}" FontSize="11" Margin="0,0,0,3"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding BackgroundColor, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource TextBoxStyle}" ToolTip="Color for JPG/BMP conversion e.g. #FFFFFF"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Resize Card -->
                    <Border Style="{DynamicResource PanelStyle}" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <CheckBox Content="Resize Image Output" IsChecked="{Binding ResizeEnabled}" FontWeight="SemiBold" FontSize="12"/>
                            
                            <Grid Margin="0,10,0,0" IsEnabled="{Binding ResizeEnabled}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Width (px)" Foreground="{DynamicResource SecondaryText}" FontSize="11" Margin="0,0,0,3"/>
                                    <TextBox Text="{Binding ResizeWidth, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource TextBoxStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Height (px)" Foreground="{DynamicResource SecondaryText}" FontSize="11" Margin="0,0,0,3"/>
                                    <TextBox Text="{Binding ResizeHeight, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource TextBoxStyle}"/>
                                </StackPanel>
                            </Grid>
                            
                            <CheckBox Content="Maintain Aspect Ratio" IsChecked="{Binding MaintainAspectRatio}" IsEnabled="{Binding ResizeEnabled}" Margin="0,10,0,0" FontSize="11"/>
                        </StackPanel>
                    </Border>

                    <!-- Optimization & Metadata Card -->
                    <Border Style="{DynamicResource PanelStyle}" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Optimization &amp; Metadata" FontWeight="SemiBold" FontSize="12"/>
                            <TextBlock Text="Performance presets &amp; metadata retention." Foreground="{DynamicResource SecondaryText}" FontSize="11" Margin="0,2,0,8"/>
                            
                            <TextBlock Text="Optimization Preset" Foreground="{DynamicResource SecondaryText}" FontSize="11" Margin="0,0,0,3"/>
                            <ComboBox ItemsSource="{Binding AvailableOptimizationPresets}" SelectedItem="{Binding OptimizationPreset}" Style="{DynamicResource ComboBoxStyle}" Margin="0,0,0,10"/>
                            
                            <TextBlock Text="Metadata Handling" Foreground="{DynamicResource SecondaryText}" FontSize="11" Margin="0,0,0,3"/>
                            <ComboBox ItemsSource="{Binding AvailableMetadataHandling}" SelectedItem="{Binding MetadataHandling}" Style="{DynamicResource ComboBoxStyle}"/>
                        </StackPanel>
                    </Border>

                    <!-- Estimated Output Result Card -->
                    <Border Style="{DynamicResource PanelStyle}" Padding="14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentColor}" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Estimated Result" FontWeight="SemiBold" FontSize="12"/>
                            </StackPanel>
                            
                            <Grid Margin="0,4,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Original Size" Foreground="{DynamicResource SecondaryText}" FontSize="10"/>
                                    <TextBlock Text="{Binding QualityComparison.OriginalSizeDisplay, TargetNullValue=—}" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock Text="{Binding QualityComparison.OriginalDimensions, TargetNullValue=—}" Foreground="{DynamicResource SecondaryText}" FontSize="10"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Estimated Size" Foreground="{DynamicResource SecondaryText}" FontSize="10"/>
                                    <TextBlock Text="{Binding QualityComparison.EstimatedSizeDisplay, TargetNullValue=—}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AccentColor}"/>
                                    <TextBlock Text="{Binding QualityComparison.EstimatedDimensions, TargetNullValue=—}" Foreground="{DynamicResource SecondaryText}" FontSize="10"/>
                                </StackPanel>
                            </Grid>
                            
                            <Border Background="{DynamicResource TabInactiveBackground}" CornerRadius="4" Padding="8,6" Margin="0,2,0,0">
                                <TextBlock Text="{Binding QualityComparison.CompressionPercentage, StringFormat=Estimated file size change: {0:0.0}%, TargetNullValue=Estimated change: —}" Foreground="{DynamicResource SuccessColor}" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Bottom Action Bar & Status -->
        <Border Grid.Row="2" Style="{DynamicResource PanelStyle}" Padding="12,10" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Output Directory Picker -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource SecondaryText}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource TextBoxStyle}" Width="270" ToolTip="Output destination directory" VerticalAlignment="Center"/>
                    <Button Content="Browse" Command="{Binding BrowseOutputCommand}" Style="{DynamicResource SecondaryButtonStyle}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                
                <!-- Status & Progress -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0">
                    <TextBlock Text="{Binding ProgressText, TargetNullValue=Ready to convert}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource PrimaryText}" TextTrimming="CharacterEllipsis"/>
                    <ProgressBar Value="{Binding OverallProgress}" Maximum="100" Height="4" Margin="0,4,0,0" Visibility="{Binding IsConverting, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>
                
                <!-- Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding OpenOutputFolderCommand}" Style="{DynamicResource SecondaryButtonStyle}" Margin="0,0,8,0" Height="34" ToolTip="Open output directory in File Explorer">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8DA;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Open Output Folder" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Content="Cancel" Command="{Binding CancelConversionCommand}" Style="{DynamicResource SecondaryButtonStyle}" Margin="0,0,8,0" Height="34" Visibility="{Binding IsConverting, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <Button Command="{Binding ConvertAllCommand}" Style="{DynamicResource PrimaryButtonStyle}" MinWidth="130" Height="34">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Convert All" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
